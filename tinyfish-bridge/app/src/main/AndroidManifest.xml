<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:label="TinyFish Control"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name="com.tinyfish.browser.bridge.MainActivity"
            android:exported="true"
            android:label="TinyFish Control">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.tinyfish.browser.bridge.TinyFishAccessibilityService"
            android:exported="true"
            android:label="TinyFish Agent Control"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tinyfish_accessibility_config" />
        </service>
    </application>
</manifest>
